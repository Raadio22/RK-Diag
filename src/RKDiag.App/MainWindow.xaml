<Window x:Class="RKDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RKDiag.App"
        Title="RK-Diag" Width="1180" Height="780" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#ECEEF1" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,23,16,20" VerticalAlignment="Top">
                    <Image Source="Assets/RK-Diag.png" Width="54" Height="54"/>
                    <StackPanel Margin="13,5,0,0">
                        <TextBlock Text="RK-Diag" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Galaxy monitor" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="OverviewNav" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="20" Width="32"/><TextBlock Text="Přehled" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="HardwareNav" Style="{StaticResource NavButtonStyle}" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="19" Width="32"/><TextBlock Text="Hardware" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ProcessesNav" Style="{StaticResource NavButtonStyle}" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="22" Width="32"/><TextBlock Text="Procesy" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="HistoryNav" Style="{StaticResource NavButtonStyle}" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="20" Width="32"/><TextBlock Text="Historie" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="32"/><TextBlock Text="Nastavení" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Margin="18,12,18,22" Padding="15" Background="#F5F7FA" CornerRadius="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CollectorDot" Width="9" Height="9" Fill="#24B36B" Margin="0,0,9,0"/>
                            <TextBlock x:Name="CollectorStatusText" Text="Sběr se spouští" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="LastUpdatedText" Text="Čekám na první hodnoty" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="18,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,31,36,36">
                    <Grid Margin="2,0,2,28">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Přehled zařízení" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeviceSubtitleText" Text="Samsung Galaxy Book" FontSize="15" Foreground="{StaticResource SubtleTextBrush}" Margin="1,7,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="15,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#24B36B" Margin="0,0,9,0"/>
                                <TextBlock Text="Systém je sledován" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel>
                        <Border Style="{StaticResource CardStyle}" Width="254" Height="174" Margin="0,0,16,16">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="#5E6268"/>
                                    <TextBlock x:Name="CpuValueText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="CpuDetailText" Text="Načítám procesor" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ProgressBar x:Name="CpuProgress" Grid.Row="1" Style="{StaticResource OneUiProgress}" Maximum="100"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Width="254" Height="174" Margin="0,0,16,16">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Paměť" FontSize="14" FontWeight="SemiBold" Foreground="#5E6268"/>
                                    <TextBlock x:Name="MemoryValueText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="MemoryDetailText" Text="Načítám paměť" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ProgressBar x:Name="MemoryProgress" Grid.Row="1" Style="{StaticResource OneUiProgress}" Foreground="#00A6B2" Maximum="100"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Width="254" Height="174" Margin="0,0,16,16">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Intel Arc" FontSize="14" FontWeight="SemiBold" Foreground="#5E6268"/>
                                    <TextBlock x:Name="GpuValueText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="GpuDetailText" Text="Načítám grafiku" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="GpuProgress" Grid.Row="1" Style="{StaticResource OneUiProgress}" Foreground="#7657E8" Maximum="100"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Width="254" Height="174" Margin="0,0,16,16">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Samsung SSD" FontSize="14" FontWeight="SemiBold" Foreground="#5E6268"/>
                                    <TextBlock x:Name="DiskValueText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DiskDetailText" Text="Načítám disk" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="DiskProgress" Grid.Row="1" Style="{StaticResource OneUiProgress}" Foreground="#F09A31" Maximum="100"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Width="254" Height="174" Margin="0,0,16,16">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Baterie" FontSize="14" FontWeight="SemiBold" Foreground="#5E6268"/>
                                    <TextBlock x:Name="BatteryValueText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="BatteryDetailText" Text="Načítám baterii" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ProgressBar x:Name="BatteryProgress" Grid.Row="1" Style="{StaticResource OneUiProgress}" Foreground="#24B36B" Maximum="100"/>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Height="250">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="Živý průběh CPU" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="poslední měření" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/></Grid>
                                <local:SparklineControl x:Name="CpuSparkline" Grid.Row="1" Margin="0,17,0,8"/>
                                <Grid Grid.Row="2"><TextBlock Text="0 %" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock Text="100 %" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/></Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Height="250">
                            <StackPanel>
                                <TextBlock Text="Dostupnost senzorů" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,17"/>
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU teplota"/><TextBlock x:Name="CpuTemperatureStatus" Grid.Column="1" Text="Ověřuji" Foreground="{StaticResource SubtleTextBrush}"/></Grid>
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Intel Arc enginy"/><TextBlock x:Name="GpuSensorStatus" Grid.Column="1" Text="Ověřuji" Foreground="{StaticResource SubtleTextBrush}"/></Grid>
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SSD teplota / SMART"/><TextBlock x:Name="SsdSensorStatus" Grid.Column="1" Text="Ověřuji" Foreground="{StaticResource SubtleTextBrush}"/></Grid>
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Paging I/O"/><TextBlock x:Name="PagingSensorStatus" Grid.Column="1" Text="Ověřuji" Foreground="{StaticResource SubtleTextBrush}"/></Grid>
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Intel NPU"/><TextBlock Grid.Column="1" Text="Zatím nedostupné" Foreground="#A36A00"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HardwarePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,31,36,36">
                    <Grid Margin="2,0,2,28">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Hardware" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HardwareSummaryText" Text="Čekám na první měření" FontSize="15" Foreground="{StaticResource SubtleTextBrush}" Margin="1,7,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="HardwareSearchBox" Style="{StaticResource OneUiSearchBox}" TextChanged="HardwareSearchBox_TextChanged" ToolTip="Hledat senzor nebo zařízení"/>
                            <TextBlock x:Name="HardwareSearchHint" Text="Hledat senzor…" Foreground="#96999F" FontSize="14" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Tento počítač" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,17"/>
                                <TextBlock Text="Model" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="HardwareModelText" Text="Samsung Galaxy Book" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,14"/>
                                <TextBlock Text="Operační paměť" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="HardwareMemoryText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Procesor" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="HardwareCpuText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="Grafika" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="HardwareGpuText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="Úložiště" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="HardwareStorageText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Rozdělení operační paměti" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Využití grafikou je už zahrnuto v celkové hodnotě. Využití PC je orientační rozdíl po odečtení právě přidělené paměti Intel Arc." FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="Celkem využito" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                    <TextBlock x:Name="HardwareMemoryUsedText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock Text="Využívá PC" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                    <TextBlock x:Name="HardwareMemoryWithoutGpuText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                    <TextBlock Text="Využívá grafika" FontSize="12" Foreground="#7657E8"/>
                                    <TextBlock x:Name="HardwareMemoryGpuText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#7657E8" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Dostupná paměť" FontSize="12" Foreground="#00A6B2"/>
                                    <TextBlock x:Name="HardwareMemoryAvailableText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#008D98" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#E7F2FF" CornerRadius="20" Padding="19,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SamsungBlue}" Margin="0,0,11,0"/>
                                <TextBlock Text="Hodnoty se aktualizují adaptivně podle aktivity aplikace a napájení." Foreground="#075CA9" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="HardwareLastUpdateText" Grid.Column="1" Text="—" Foreground="#3974A9" FontSize="12"/>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="HardwareGroupsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Visibility="{Binding Visibility}">
                                    <StackPanel>
                                        <Button Tag="{Binding}" Click="HardwareGroupHeader_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Accent}" Margin="0,0,11,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="23,5,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#F2F4F7" CornerRadius="12" Padding="10,5">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}">
                                                            <Run Text="{Binding Metrics.Count, Mode=OneWay}"/><Run Text=" hodnot"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding ToggleText}" Foreground="{StaticResource SamsungBlue}" FontSize="12" Margin="13,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Metrics}" Visibility="{Binding DetailsVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#ECEEF1" BorderThickness="0,1,0,0" Padding="2,13" Visibility="{Binding Visibility}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding ValueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Foreground="{Binding ValueBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="104" TextAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="HardwareEmptyFilterPanel" Visibility="Collapsed" Background="White" CornerRadius="26" Padding="38" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Žádný odpovídající senzor" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Zkus jiný název. Nedostupné senzory se v seznamu neobjeví, dokud je Windows nebo firmware neposkytne." FontSize="13" Foreground="{StaticResource SubtleTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ProcessesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,31,36,36">
                    <Grid Margin="2,0,2,26">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Procesy" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProcessesSummaryText" Text="Čekám na první měření" FontSize="15" Foreground="{StaticResource SubtleTextBrush}" Margin="1,7,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="ProcessSearchBox" Style="{StaticResource OneUiSearchBox}" TextChanged="ProcessSearchBox_TextChanged" ToolTip="Hledat proces"/>
                            <TextBlock x:Name="ProcessSearchHint" Text="Hledat proces…" Foreground="#96999F" FontSize="14" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox x:Name="ProcessSortBox" Grid.Column="3" Height="44" Padding="12,0" VerticalContentAlignment="Center" SelectionChanged="ProcessSortBox_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="Nejvyšší CPU" Tag="CPU"/>
                            <ComboBoxItem Content="Nejvyšší RAM" Tag="RAM"/>
                            <ComboBoxItem Content="Nejvyšší GPU" Tag="GPU"/>
                            <ComboBoxItem Content="Nejvyšší GPU RAM" Tag="GpuRam"/>
                            <ComboBoxItem Content="Nejvyšší disk" Tag="Disk"/>
                        </ComboBox>
                    </Grid>

                    <WrapPanel Margin="0,0,0,2">
                        <Border Style="{StaticResource CardStyle}" Width="222" Height="118" Margin="0,0,14,14">
                            <StackPanel><TextBlock Text="Nejvyšší CPU" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock x:Name="TopCpuProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopCpuProcessDetail" Text="0 %" Foreground="{StaticResource SamsungBlue}" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Width="222" Height="118" Margin="0,0,14,14">
                            <StackPanel><TextBlock Text="Nejvyšší RAM" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock x:Name="TopMemoryProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopMemoryProcessDetail" Text="0,00 GB" Foreground="#008D98" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Width="222" Height="118" Margin="0,0,14,14">
                            <StackPanel><TextBlock Text="Nejvyšší GPU" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock x:Name="TopGpuProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopGpuProcessDetail" Text="0 %" Foreground="#7657E8" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Width="222" Height="118" Margin="0,0,14,14">
                            <StackPanel><TextBlock Text="Nejvyšší GPU RAM" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock x:Name="TopGpuMemoryProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopGpuMemoryProcessDetail" Text="0,00 GB" Foreground="#7657E8" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Width="222" Height="118" Margin="0,0,14,14">
                            <StackPanel><TextBlock Text="Nejvyšší disk" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/><TextBlock x:Name="TopDiskProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopDiskProcessDetail" Text="0 B/s" Foreground="#D77D13" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Background="#E7F2FF" CornerRadius="20" Padding="18,13" Margin="0,0,0,16">
                        <TextBlock Text="CPU a disk jsou počítané z rozdílu mezi měřeními. GPU RAM je paměť mapovaná procesu; řádky se kvůli sdíleným obrazovým plochám nesčítají a hodnota procesu může být vyšší než skutečně obsazená GPU RAM." Foreground="#075CA9" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Background="#F8F9FB" Margin="1" Height="45">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="78"/><ColumnDefinition Width="94"/><ColumnDefinition Width="76"/><ColumnDefinition Width="94"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Proces" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="PID" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="CPU" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="RAM" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="GPU" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="5" Text="GPU RAM" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock Grid.Column="6" Text="Disk" Margin="0,0,20,0" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                            </Grid>
                            <ItemsControl x:Name="ProcessItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#ECEEF1" BorderThickness="0,1,0,0" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="78"/><ColumnDefinition Width="94"/><ColumnDefinition Width="76"/><ColumnDefinition Width="94"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="20,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding ActivityDetail}" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessId}" VerticalAlignment="Center" TextAlignment="Right" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource SamsungBlue}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="4" Text="{Binding GpuText}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="#7657E8"/>
                                                <TextBlock Grid.Column="5" Text="{Binding GpuMemoryText}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="#7657E8"/>
                                                <TextBlock Grid.Column="6" Text="{Binding DiskText}" Margin="0,0,20,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="#B56C17"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="ProcessesEmptyPanel" Visibility="Collapsed" Padding="35">
                                <TextBlock Text="Žádný odpovídající proces" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="PlaceholderPage" Visibility="Collapsed" Margin="36">
                <Border Background="White" CornerRadius="30" Padding="48" MaxWidth="680" MaxHeight="360">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" Text="Další část RK-Diag" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderText" Text="Tato stránka bude doplněna v dalším kroku." TextAlignment="Center" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource SubtleTextBrush}" Margin="0,16,0,0"/>
                        <Border Background="#E7F2FF" CornerRadius="18" Padding="18,11" Margin="0,28,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="Sběr dat mezitím pokračuje" Foreground="{StaticResource SamsungBlue}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
